node_modules/
.DS_Store
.wrangler/
dist/
.dev.vars
*.log
.claude/

# The buildthis Action writes the built site name here for its reply step to
# read; it must never be committed to main. See notes/80-buildthis-bot.md.
BUILD_RESULT

# Optional: the build agent's own short line about what it built (or its answer
# to an "explain <site>" ask), prepended to the success reply. Same mechanism as
# BUILD_RESULT — written at build time, read by the reply step, never committed.
BUILD_NOTE
# BUILD_MAINTENANCE — a sweep's one-line summary, same lifecycle as the two above.
BUILD_MAINTENANCE
# BUILD_REACTION — presence-only flag: this run's BUILD_NOTE is a reply to banter/
# a question, not a decline of a real ask. Same lifecycle as the files above.
BUILD_REACTION

# The build step tees the Claude CLI output here so the "classify failure" step
# can tell an out-of-budget failure from a genuine one. Build-time only.
build-output.log

# audit/pull-bot-threads.mjs output (several MB of notification JSON)
audit/raw/bot-threads/
