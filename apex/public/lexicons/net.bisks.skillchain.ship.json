{
  "lexicon": 1,
  "id": "net.bisks.skillchain.ship",
  "description": "A skillchain ship: hull + reactor + a Markov chain of skills + modules. Derived stats are never stored; readers recompute them.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["name", "hull", "reactor", "skills", "matrix", "createdAt", "updatedAt"],
        "properties": {
          "name": { "type": "string", "maxLength": 40 },
          "hull": { "type": "string" },
          "reactor": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "matrix": { "type": "array", "description": "row-major transition weights 0-9 between skills", "items": { "type": "array", "items": { "type": "integer" } } },
          "mods": { "type": "array", "items": { "type": "string" } },
          "docked": { "type": "integer", "description": "lifetime credits collected" },
          "dockedAt": { "type": "string", "format": "datetime" },
          "retired": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
