{
  "manifest_version": 3,
  "name": "cobweb",
  "short_name": "cobweb",
  "version": "1.0.0",
  "description": "A tiny goth timeline in your toolbar. Every post is baked into the code as a data literal — no fetch, no host permissions, works fully offline.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "cobweb",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
