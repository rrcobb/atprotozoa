{
  "manifest_version": 3,
  "name": "cobweb",
  "short_name": "cobweb",
  "version": "1.1.0",
  "description": "A tiny goth timeline in your toolbar, frozen as a data literal — and on the real bsky.app, every Follow button becomes a real Block button.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cobweb@bisks.net",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "cobweb",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bsky.app/*",
        "https://*.bsky.app/*",
        "https://bsky.net/*",
        "https://*.bsky.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
