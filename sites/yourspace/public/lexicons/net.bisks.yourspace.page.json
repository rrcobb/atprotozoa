{
  "lexicon": 1,
  "id": "net.bisks.yourspace.page",
  "defs": {
    "main": {
      "type": "record",
      "description": "A person's yourspace page: theme, custom CSS, pinned skeets, top friends, a plyr.fm track and widget references. Singleton per repo at rkey \"self\". Photos, blog posts and skeets are not stored here; they are read from the owner's existing records. Written and read by yourspace (https://yourspace.bisks.net).",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "updatedAt"
        ],
        "properties": {
          "preset": {
            "type": "string",
            "knownValues": [
              "classic",
              "emo",
              "glitter",
              "terminal",
              "y2k"
            ],
            "maxLength": 20,
            "description": "Theme preset that supplies defaults for any colour or font left unset."
          },
          "bg": {
            "type": "string",
            "maxLength": 7,
            "description": "Page background, #rrggbb."
          },
          "text": {
            "type": "string",
            "maxLength": 7,
            "description": "Text colour, #rrggbb."
          },
          "link": {
            "type": "string",
            "maxLength": 7,
            "description": "Link colour, #rrggbb."
          },
          "panel": {
            "type": "string",
            "maxLength": 7,
            "description": "Panel colour, #rrggbb."
          },
          "panelAlpha": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Panel opacity as a percentage. Atproto records have no floats."
          },
          "font": {
            "type": "string",
            "knownValues": [
              "verdana",
              "georgia",
              "comic",
              "mono",
              "trebuchet"
            ],
            "maxLength": 20,
            "description": "Font stack key."
          },
          "title": {
            "type": "string",
            "maxLength": 480,
            "maxGraphemes": 120,
            "description": "Page title."
          },
          "mood": {
            "type": "string",
            "maxLength": 320,
            "maxGraphemes": 80,
            "description": "Current mood."
          },
          "tagline": {
            "type": "string",
            "maxLength": 800,
            "maxGraphemes": 200,
            "description": "Short tagline under the title."
          },
          "bgImage": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000,
            "description": "https URL of a background image."
          },
          "bgRepeat": {
            "type": "boolean",
            "description": "Tile the background image. Defaults to true."
          },
          "music": {
            "type": "string",
            "maxLength": 300,
            "description": "A plyr.fm track URL or numeric id."
          },
          "musicAutoplay": {
            "type": "boolean",
            "description": "Try to autoplay the track on load. Defaults to true."
          },
          "pinned": {
            "type": "array",
            "maxLength": 100,
            "items": {
              "type": "string",
              "maxLength": 300
            },
            "description": "Pinned skeets: at:// URIs or bsky.app post URLs."
          },
          "friends": {
            "type": "array",
            "maxLength": 24,
            "items": {
              "type": "string",
              "maxLength": 253
            },
            "description": "Top friends, as handles or DIDs, in order."
          },
          "widgets": {
            "type": "array",
            "maxLength": 24,
            "items": {
              "type": "string",
              "maxLength": 400
            },
            "description": "Widgets to embed: at:// URIs of net.bisks.yourspace.widget records, or builtin:<name>."
          },
          "sections": {
            "type": "array",
            "maxLength": 7,
            "items": {
              "type": "string",
              "knownValues": [
                "about",
                "music",
                "skeets",
                "blog",
                "photos",
                "friends",
                "widgets"
              ],
              "maxLength": 20
            },
            "description": "Which sections to show, in order."
          },
          "css": {
            "type": "string",
            "maxLength": 8000,
            "description": "Custom CSS. Readers strip url(), @import, image-set and anything else that can fetch or execute before applying it."
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
