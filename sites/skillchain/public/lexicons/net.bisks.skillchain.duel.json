{
  "lexicon": 1,
  "id": "net.bisks.skillchain.duel",
  "description": "An async duel: both builds are embedded as snapshots and the fight is a pure function of them, so anyone can recompute the result.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["defender", "attackerShip", "defenderShip", "winner", "createdAt"],
        "properties": {
          "defender": { "type": "string", "format": "did" },
          "defenderRkey": { "type": "string" },
          "attackerShip": { "type": "unknown" },
          "defenderShip": { "type": "unknown" },
          "seed": { "type": "integer" },
          "winner": { "type": "string", "knownValues": ["a", "b", "draw"] },
          "rounds": { "type": "integer" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
