{
  "lexicon": 1,
  "id": "net.bisks.void.murmur",
  "defs": {
    "main": {
      "type": "record",
      "description": "Carries a Shout (or another Echo/Murmur) to a new Place with a short reaction attached — the telephone-game version of an Echo. rkey is deterministic, same scheme as net.bisks.void.echo.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["rootUri", "parentUri", "place", "text", "createdAt"],
        "properties": {
          "rootUri": { "type": "string", "format": "at-uri" },
          "parentUri": { "type": "string", "format": "at-uri" },
          "place": { "type": "ref", "ref": "net.bisks.void.shout#place" },
          "text": {
            "type": "string",
            "maxGraphemes": 140,
            "maxLength": 1500,
            "description": "A short reaction carried alongside the shout — how this Place received it."
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
