{
  // Typecheck only: wrangler/esbuild strips types at deploy and never runs tsc,
  // so a type error in a Worker used to ship silently. `pnpm check:types`
  // (also a step in deploy.yml's check job) runs this. Scoped to the sites
  // listed in `include`; add a site there when you want it checked.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["sites/buildthis/src/**/*.ts"]
}
